# Example AGENTS.toml with Tags
# This shows how to use tagged modules

[config]
module_dir = ".mogent/examples"

[order]
categories = ["identity", "instructions", "constraints", "format", "team"]

[category.identity]
[[category.identity.module]]
name = "identity"
source = "simple-identity.md"

[category.instructions]
[[category.instructions.module]]
name = "instructions"
source = "simple-instructions.md"

[category.constraints]
[[category.constraints.module]]
name = "constraints"
source = "simple-constraints.md"

[category.format]
[[category.format.module]]
name = "format"
source = "simple-format.md"

[category.team]
tags = ["team/backend", "team/frontend"]

[[category.team.module]]
name = "backend"
source = "tagged-backend.md"
tags = ["team/backend"]

[[category.team.module]]
name = "frontend"
source = "tagged-frontend.md"
tags = ["team/frontend"]

[[category.team.module]]
name = "decisions"
source = "tagged-decisions.md"
tags = ["process/decisions"]

[activate]
scopes = ["team/backend"]

[output]
path = "AGENTS.backend.md.example"
