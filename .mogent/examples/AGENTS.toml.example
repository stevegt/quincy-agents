# Example AGENTS.toml
# This shows how to use the simple examples

[config]
module_dir = ".mogent/examples"

[order]
categories = ["identity", "instructions", "constraints", "format"]

[category.identity]
[[category.identity.module]]
name = "identity"
source = "simple-identity.md"

[category.instructions]
[[category.instructions.module]]
name = "instructions"
source = "simple-instructions.md"

[category.constraints]
[[category.constraints.module]]
name = "constraints"
source = "simple-constraints.md"

[category.format]
[[category.format.module]]
name = "format"
source = "simple-format.md"

[activate]
scopes = []

[output]
path = "AGENTS.md.example"
